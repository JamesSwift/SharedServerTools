# Included from Debian's acl_check_data via CHECK_DATA_LOCAL_ACL_FILE.
# SMTP AUTH may only From: addresses listed for that unix user.
# Unauthenticated SMTP from +relay_from_hosts requires AUTH.
# Inbound MX is unrestricted. Local sendmail is acl_not_smtp.

deny
  authenticated = *
  ! acl = acl_check_sender ${authenticated_id}

deny
  hosts = +relay_from_hosts
  !authenticated = *
  message = Authentication required to submit mail from this host.

# SpamAssassin via exim4-daemon-heavy content scanning.
# Skip huge messages (spamd can time out). Scan once; $spam_score_int is
# in tenths (30 == 3.0, 70 == 7.0).
accept  condition = ${if >={$message_size}{500k}{yes}{no}}
warn    spam = nobody:true
        add_header = X-SA-Score: $spam_score
warn    condition = ${if >{$spam_score_int}{0}{true}{false}}
        add_header = X-SA-Report: $spam_report
warn    condition = ${if >{$spam_score_int}{30}{true}{false}}
        add_header = X-SA-Status: Yes
deny    message = This message looks like spam. Rather than it get lost in a spam folder, we thought it better to simply reject it.
        condition = ${if >{$spam_score_int}{70}{true}{false}}
